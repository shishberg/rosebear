{
  "name": "rosebear-chassis-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/geometry.test.ts tests/hand.test.ts tests/solid-checks.test.ts tests/wiring.test.ts tests/report-lines.test.ts tests/handles.test.ts tests/hand-solve.test.ts",
    "test:browser": "playwright test",
    "test:hand": "playwright test -c playwright.hand.config.ts",
    "test:fit": "node --import tsx tests/fit-check.ts",
    "format": "npx --yes prettier@3 --write \"src/**/*.ts\" \"src/**/*.json\" \"tests/**/*.ts\"",
    "fingerprint": "node --import tsx tests/fingerprint.ts"
  },
  "dependencies": {
    "manifold-3d": "^3.2.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.55.0"
  }
}
